{
  "name": "project",
  "version": "1.0.0",
  "description": "",
  "main": "backend/src/server.js",
  "scripts": {
    "start": "node backend/src/server.js",
    "test": "node backend/src/test/run-full-tests.js",
    "dev": "npm run dev:backend & npm run dev:frontend",
    "dev:backend": "cd backend && nodemon src/server.js",
    "dev:frontend": "cd frontend && npm run dev",
    "build": "cd frontend && npm run build",
    "test:unit": "cd backend && npm run test:unit",
    "test:e2e": "cd backend && node tests/integration/alert-service-e2e.js",
    "test:protocol": "cd backend && node tests/unit/monitor.comprehensive.test.js",
    "test:all": "npm test",
    "sync:atlas": "cd backend && node scripts/sync-to-atlas.js",
    "install:backend": "cd backend && npm install",
    "install:frontend": "cd frontend && npm install",
    "install:all": "npm run install:backend && npm run install:frontend"
  },
  "dependencies": {
    "express": "^4.18.2",
    "socket.io": "^4.7.2"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.0.1"
  }
}
